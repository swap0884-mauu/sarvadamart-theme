{{ 'sm-flash-deals.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sm-flash-deals.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign featured_collection = section.settings.collection
%}

<section
  id="SMFlashDeals-{{ section.id }}"
  class="sm-flash-deals color-{{ section.settings.color_scheme }} gradient"
  data-sm-flash-deals
  data-countdown-end="{{ section.settings.countdown_end_date | escape }}"
  aria-labelledby="SMFlashDealsHeading-{{ section.id }}"
>
  <div class="page-width sm-flash-deals__container">
    <div class="sm-flash-deals__header">
      <div class="sm-flash-deals__heading-group">
        {% if section.settings.subtitle != blank %}
          <p class="sm-flash-deals__subtitle">{{ section.settings.subtitle | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 id="SMFlashDealsHeading-{{ section.id }}" class="sm-flash-deals__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>

      <div class="sm-flash-deals__countdown" data-countdown aria-live="polite">
        <span class="visually-hidden">Offer ends in </span>
        <div class="sm-flash-deals__time-block"><span class="sm-flash-deals__time-value" data-hours>00</span><span class="sm-flash-deals__time-label">Hours</span></div>
        <span class="sm-flash-deals__separator" aria-hidden="true">:</span>
        <div class="sm-flash-deals__time-block"><span class="sm-flash-deals__time-value" data-minutes>00</span><span class="sm-flash-deals__time-label">Minutes</span></div>
        <span class="sm-flash-deals__separator" aria-hidden="true">:</span>
        <div class="sm-flash-deals__time-block"><span class="sm-flash-deals__time-value" data-seconds>00</span><span class="sm-flash-deals__time-label">Seconds</span></div>
        <span class="sm-flash-deals__expired" data-expired hidden>Offer Expired</span>
      </div>
    </div>

    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <div class="sm-flash-deals__carousel" data-carousel>
        <button class="sm-flash-deals__carousel-button sm-flash-deals__carousel-button--previous" type="button" data-carousel-previous aria-label="Show previous products">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="m14.5 5-7 7 7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
        </button>

        <ul class="sm-flash-deals__product-list" data-product-list tabindex="0" aria-label="Flash deal products">
          {% for product in featured_collection.products limit: section.settings.products_to_show %}
            {% liquid
              assign current_variant = product.selected_or_first_available_variant
              assign sale_price = current_variant.price
              assign compare_price = current_variant.compare_at_price
              assign image_alt = product.featured_image.alt | default: product.title
              assign discount_percentage = 0
              if compare_price > sale_price
                assign discount_amount = compare_price | minus: sale_price
                assign discount_percentage = discount_amount | times: 100.0 | divided_by: compare_price | round
              endif
              assign rating = product.metafields.reviews.rating.value.rating
              assign rating_count = product.metafields.reviews.rating_count
            %}
            <li class="sm-flash-deals__product-item">
              <article class="sm-flash-deals__card">
                <div class="sm-flash-deals__media">
                  {% if discount_percentage > 0 %}
                    <span class="sm-flash-deals__badge">Save {{ discount_percentage }}%</span>
                  {% endif %}
                  <div class="sm-flash-deals__actions">
                    <button class="sm-flash-deals__action-button" type="button" aria-label="Add {{ product.title | escape }} to wishlist">
                      <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M20.8 4.8a5.5 5.5 0 0 0-7.8 0L12 5.9l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21.5l7.8-7.8 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/></svg>
                    </button>
                    <button class="sm-flash-deals__action-button" type="button" aria-label="Quick view {{ product.title | escape }}">
                      <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="2.8" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
                    </button>
                  </div>
                  <a class="sm-flash-deals__media-link" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                    {% if product.featured_image != blank %}
                      {{ product.featured_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '240, 360, 480, 600, 720', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 83vw', class: 'sm-flash-deals__image', alt: image_alt }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'sm-flash-deals__placeholder placeholder-svg' }}
                    {% endif %}
                  </a>
                </div>

                <div class="sm-flash-deals__content">
                  <h3 class="sm-flash-deals__product-title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                  {% if rating != blank %}
                    <div class="sm-flash-deals__rating" aria-label="Rated {{ rating }} out of 5{% if rating_count != blank %} from {{ rating_count }} reviews{% endif %}">
                      <span class="sm-flash-deals__rating-stars" aria-hidden="true">★★★★★</span>
                      <span>{{ rating }}</span>
                      {% if rating_count != blank %}<span class="sm-flash-deals__rating-count">({{ rating_count }})</span>{% endif %}
                    </div>
                  {% endif %}
                  <div class="sm-flash-deals__price">
                    <span class="sm-flash-deals__sale-price">{{ sale_price | money }}</span>
                    {% if compare_price > sale_price %}<s class="sm-flash-deals__compare-price">{{ compare_price | money }}</s>{% endif %}
                  </div>
                  <p class="sm-flash-deals__stock {% unless current_variant.available %}sm-flash-deals__stock--sold-out{% endunless %}">
                    {% if current_variant.available %}In stock{% else %}Sold out{% endif %}
                  </p>
                  {% form 'product', product, class: 'sm-flash-deals__form' %}
                    <input type="hidden" name="id" value="{{ current_variant.id }}">
                    <button class="sm-flash-deals__add-button" type="submit" {% unless current_variant.available %}disabled{% endunless %}>
                      {% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}
                    </button>
                  {% endform %}
                </div>
              </article>
            </li>
          {% endfor %}
        </ul>

        <button class="sm-flash-deals__carousel-button sm-flash-deals__carousel-button--next" type="button" data-carousel-next aria-label="Show next products">
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="m9.5 5 7 7-7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/></svg>
        </button>
      </div>
    {% else %}
      <p class="sm-flash-deals__empty">Select a collection to show flash-deal products.</p>
    {% endif %}

    {% if section.settings.button_label != blank %}
      <div class="sm-flash-deals__footer">
        <a class="sm-flash-deals__view-all" href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% elsif featured_collection != blank %}{{ featured_collection.url }}{% else %}#{% endif %}">{{ section.settings.button_label | escape }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "SM Flash deals",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Flash Deals" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Limited Time Offers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "countdown_end_date", "label": "Countdown end date", "default": "2026-12-31T23:59:59", "info": "Use ISO format, for example 2026-12-31T23:59:59." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 20, "step": 1, "default": 8 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View all deals" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [
    { "name": "SM Flash deals" }
  ]
}
{% endschema %}
