{% comment %}
  SM Hero Banner — Shopify OS 2.0 / Dawn compatible
  Place this file at: sections/sm-hero-banner.liquid
{% endcomment %}

{% style %}
  #shopify-section-{{ section.id }} .smhero { --smh-green: #00845D; --smh-gold: #d7a74c; --smh-ink: #173129; --smh-muted: #587067; position: relative; overflow: hidden; font-family: var(--font-body-family, Arial, sans-serif); }
  #shopify-section-{{ section.id }} .smhero *, #shopify-section-{{ section.id }} .smhero *:before, #shopify-section-{{ section.id }} .smhero *:after { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .smhero__viewport { position: relative; overflow: hidden; }
  #shopify-section-{{ section.id }} .smhero__track { display: flex; transition: transform .65s cubic-bezier(.22,.61,.36,1); will-change: transform; }
  #shopify-section-{{ section.id }} .smhero__slide { position: relative; width: 100%; min-width: 100%; min-height: {{ section.settings.desktop_height }}px; display: flex; align-items: center; overflow: hidden; background: linear-gradient(120deg, #eaf8f1, #d8f0e4); }
  #shopify-section-{{ section.id }} .smhero__shape { position: absolute; border-radius: 50%; pointer-events: none; }
  #shopify-section-{{ section.id }} .smhero__shape--one { width: min(45vw, 680px); height: min(45vw, 680px); top: -24%; right: -8%; background: rgba(255,255,255,.44); }
  #shopify-section-{{ section.id }} .smhero__shape--two { width: min(26vw, 370px); height: min(26vw, 370px); bottom: -20%; left: 39%; border: 1px solid rgba(255,255,255,.52); }
  #shopify-section-{{ section.id }} .smhero__pattern { position: absolute; inset: 0; opacity: .3; pointer-events: none; background-image: radial-gradient(circle at 1px 1px, rgba(0,132,93,.14) 1px, transparent 1.2px); background-size: 22px 22px; mask-image: linear-gradient(90deg, #000 0%, transparent 72%); }
  #shopify-section-{{ section.id }} .smhero__inner { position: relative; z-index: 1; width: min(100%, 1440px); margin: 0 auto; padding: 62px clamp(24px, 7vw, 112px); display: grid; grid-template-columns: minmax(0, .95fr) minmax(380px, 1.05fr); align-items: center; gap: clamp(35px, 5vw, 95px); }
  #shopify-section-{{ section.id }} .smhero__content { max-width: 650px; }
  #shopify-section-{{ section.id }} .smhero__badge { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 20px; padding: 8px 13px; border: 1px solid rgba(0,132,93,.16); border-radius: 100px; background: rgba(255,255,255,.68); color: var(--smh-green); font-size: 11px; font-weight: 800; letter-spacing: .1em; line-height: 1; text-transform: uppercase; box-shadow: 0 4px 16px rgba(0,77,53,.06); }
  #shopify-section-{{ section.id }} .smhero__badge:before { width: 7px; height: 7px; content: ''; border-radius: 50%; background: var(--smh-gold); box-shadow: 0 0 0 3px rgba(215,167,76,.18); }
  #shopify-section-{{ section.id }} .smhero__kicker { margin: 0 0 12px; color: var(--smh-green); font-size: 13px; font-weight: 800; letter-spacing: .09em; line-height: 1.3; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .smhero__heading { max-width: 650px; margin: 0; color: var(--smh-ink); font-family: var(--font-heading-family, Georgia, serif); font-size: clamp(39px, 4.5vw, 70px); font-weight: 700; letter-spacing: -.055em; line-height: .99; }
  #shopify-section-{{ section.id }} .smhero__heading strong { color: var(--smh-green); font-weight: inherit; }
  #shopify-section-{{ section.id }} .smhero__description { max-width: 545px; margin: 21px 0 0; color: var(--smh-muted); font-size: clamp(14px, 1.35vw, 17px); line-height: 1.65; }
  #shopify-section-{{ section.id }} .smhero__buttons { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  #shopify-section-{{ section.id }} .smhero__button { min-height: 50px; display: inline-flex; align-items: center; justify-content: center; gap: 9px; padding: 12px 21px; border: 1px solid transparent; border-radius: 8px; font-size: 13px; font-weight: 800; letter-spacing: .01em; line-height: 1.1; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease, color .2s ease, background-color .2s ease, border-color .2s ease; }
  #shopify-section-{{ section.id }} .smhero__button--primary { background: var(--smh-green); color: #fff; box-shadow: 0 9px 18px rgba(0,132,93,.22); }
  #shopify-section-{{ section.id }} .smhero__button--secondary { border-color: rgba(0,132,93,.28); background: rgba(255,255,255,.6); color: var(--smh-green); }
  #shopify-section-{{ section.id }} .smhero__button:hover { transform: translateY(-2px); }
  #shopify-section-{{ section.id }} .smhero__button--primary:hover { background: #006e4e; box-shadow: 0 12px 24px rgba(0,132,93,.29); }
  #shopify-section-{{ section.id }} .smhero__button--secondary:hover { border-color: var(--smh-green); background: #fff; }
  #shopify-section-{{ section.id }} .smhero__button:focus-visible, #shopify-section-{{ section.id }} .smhero__arrow:focus-visible, #shopify-section-{{ section.id }} .smhero__dot:focus-visible { outline: 3px solid #d7a74c; outline-offset: 3px; }
  #shopify-section-{{ section.id }} .smhero__trust { display: flex; flex-wrap: wrap; gap: 12px 20px; margin: 30px 0 0; padding: 0; list-style: none; }
  #shopify-section-{{ section.id }} .smhero__trust-item { display: flex; align-items: center; gap: 6px; color: #405a50; font-size: 11px; font-weight: 750; white-space: nowrap; }
  #shopify-section-{{ section.id }} .smhero__check { display: grid; width: 18px; height: 18px; place-items: center; border-radius: 50%; background: rgba(0,132,93,.11); color: var(--smh-green); }
  #shopify-section-{{ section.id }} .smhero__check svg { width: 11px; height: 11px; fill: none; stroke: currentColor; stroke-width: 2.5; }
  #shopify-section-{{ section.id }} .smhero__visual { position: relative; min-height: min(39vw, 500px); display: grid; place-items: center; }
  #shopify-section-{{ section.id }} .smhero__image-shell { position: relative; z-index: 2; width: min(100%, 525px); aspect-ratio: 1.05; overflow: hidden; border-radius: 42% 42% 33% 33% / 35% 35% 44% 44%; background: linear-gradient(145deg, rgba(255,255,255,.74), rgba(234,247,239,.3)); box-shadow: 0 22px 45px rgba(20,83,59,.16); animation: smhero-float-{{ section.id }} 5.2s ease-in-out infinite; }
  #shopify-section-{{ section.id }} .smhero__image { display: block; width: 100%; height: 100%; object-fit: cover; }
  #shopify-section-{{ section.id }} .smhero__image-placeholder { width: 100%; height: 100%; background: radial-gradient(circle at 35% 30%, #fff9d6 0 10%, transparent 10.5%), radial-gradient(circle at 70% 37%, #f5bd4a 0 12%, transparent 12.5%), radial-gradient(circle at 56% 73%, #71b759 0 18%, transparent 18.5%), linear-gradient(145deg,#fffef7,#d7f1df); }
  #shopify-section-{{ section.id }} .smhero__float-card { position: absolute; z-index: 3; display: flex; align-items: center; gap: 9px; padding: 10px 12px; border: 1px solid rgba(255,255,255,.9); border-radius: 11px; background: rgba(255,255,255,.82); box-shadow: 0 11px 24px rgba(20,74,55,.13); backdrop-filter: blur(8px); color: var(--smh-ink); font-size: 11px; font-weight: 800; line-height: 1.2; animation: smhero-float-{{ section.id }} 4.4s ease-in-out infinite reverse; }
  #shopify-section-{{ section.id }} .smhero__float-card--top { top: 10%; left: -1%; } #shopify-section-{{ section.id }} .smhero__float-card--bottom { right: -1%; bottom: 11%; animation-delay: .6s; }
  #shopify-section-{{ section.id }} .smhero__float-icon { width: 27px; height: 27px; display: grid; flex: 0 0 auto; place-items: center; border-radius: 8px; background: #e5f5ed; color: var(--smh-green); }
  #shopify-section-{{ section.id }} .smhero__float-icon svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  #shopify-section-{{ section.id }} .smhero__leaf { position: absolute; z-index: 1; width: 74px; height: 42px; border-radius: 100% 0 100% 0; background: rgba(57,157,102,.17); transform: rotate(-25deg); } #shopify-section-{{ section.id }} .smhero__leaf--one { top: 5%; right: 6%; } #shopify-section-{{ section.id }} .smhero__leaf--two { bottom: 2%; left: 7%; transform: rotate(140deg) scale(.75); }
  #shopify-section-{{ section.id }} .smhero__arrow { position: absolute; z-index: 5; top: 50%; width: 43px; height: 43px; display: grid; place-items: center; border: 1px solid rgba(0,132,93,.15); border-radius: 50%; background: rgba(255,255,255,.8); color: var(--smh-green); box-shadow: 0 7px 18px rgba(17,73,53,.1); cursor: pointer; transform: translateY(-50%); transition: background-color .2s ease, color .2s ease, transform .2s ease; }
  #shopify-section-{{ section.id }} .smhero__arrow:hover { background: var(--smh-green); color: #fff; transform: translateY(-50%) scale(1.06); } #shopify-section-{{ section.id }} .smhero__arrow--prev { left: clamp(10px, 2vw, 30px); } #shopify-section-{{ section.id }} .smhero__arrow--next { right: clamp(10px, 2vw, 30px); }
  #shopify-section-{{ section.id }} .smhero__arrow svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  #shopify-section-{{ section.id }} .smhero__dots { position: absolute; z-index: 5; bottom: 19px; left: 50%; display: flex; align-items: center; gap: 8px; transform: translateX(-50%); } #shopify-section-{{ section.id }} .smhero__dot { width: 8px; height: 8px; padding: 0; border: 0; border-radius: 100px; background: rgba(0,132,93,.27); cursor: pointer; transition: width .2s ease, background-color .2s ease; } #shopify-section-{{ section.id }} .smhero__dot[aria-current="true"] { width: 25px; background: var(--smh-green); }
  #shopify-section-{{ section.id }} .smhero__slide:not(.is-active) .smhero__content, #shopify-section-{{ section.id }} .smhero__slide:not(.is-active) .smhero__visual { opacity: 0; } #shopify-section-{{ section.id }} .smhero__slide.is-active .smhero__content { animation: smhero-reveal-{{ section.id }} .62s .08s both; } #shopify-section-{{ section.id }} .smhero__slide.is-active .smhero__visual { animation: smhero-reveal-{{ section.id }} .68s .16s both; }
  @keyframes smhero-reveal-{{ section.id }} { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } } @keyframes smhero-float-{{ section.id }} { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  @media screen and (max-width: 989px) { #shopify-section-{{ section.id }} .smhero__slide { min-height: {{ section.settings.tablet_height }}px; } #shopify-section-{{ section.id }} .smhero__inner { grid-template-columns: minmax(0, 1fr) minmax(300px, .85fr); gap: 28px; padding-inline: 60px; } #shopify-section-{{ section.id }} .smhero__visual { min-height: 360px; } #shopify-section-{{ section.id }} .smhero__float-card--top { left: -9%; } #shopify-section-{{ section.id }} .smhero__float-card--bottom { right: -8%; } }
  @media screen and (max-width: 749px) { #shopify-section-{{ section.id }} .smhero__slide { min-height: {{ section.settings.mobile_height }}px; align-items: flex-start; } #shopify-section-{{ section.id }} .smhero__shape--one { width: 470px; height: 470px; top: 34%; right: -52%; } #shopify-section-{{ section.id }} .smhero__shape--two { bottom: -16%; left: -24%; width: 260px; height: 260px; } #shopify-section-{{ section.id }} .smhero__pattern { mask-image: none; opacity: .18; } #shopify-section-{{ section.id }} .smhero__inner { padding: 42px 23px 62px; grid-template-columns: 1fr; gap: 25px; } #shopify-section-{{ section.id }} .smhero__content { text-align: center; } #shopify-section-{{ section.id }} .smhero__badge { margin-bottom: 15px; } #shopify-section-{{ section.id }} .smhero__kicker { margin-bottom: 8px; font-size: 11px; } #shopify-section-{{ section.id }} .smhero__heading { font-size: clamp(35px, 10vw, 49px); } #shopify-section-{{ section.id }} .smhero__description { margin-inline: auto; font-size: 14px; } #shopify-section-{{ section.id }} .smhero__buttons { justify-content: center; margin-top: 22px; } #shopify-section-{{ section.id }} .smhero__button { min-height: 46px; padding-inline: 16px; font-size: 12px; } #shopify-section-{{ section.id }} .smhero__trust { justify-content: center; gap: 9px 12px; margin-top: 22px; } #shopify-section-{{ section.id }} .smhero__trust-item { font-size: 10px; } #shopify-section-{{ section.id }} .smhero__visual { min-height: 270px; max-width: 365px; margin: 0 auto; width: 100%; } #shopify-section-{{ section.id }} .smhero__image-shell { width: min(84vw, 320px); } #shopify-section-{{ section.id }} .smhero__float-card { padding: 8px 9px; font-size: 9px; } #shopify-section-{{ section.id }} .smhero__float-card--top { top: 7%; left: 0; } #shopify-section-{{ section.id }} .smhero__float-card--bottom { right: 0; bottom: 5%; } #shopify-section-{{ section.id }} .smhero__float-icon { width: 21px; height: 21px; border-radius: 6px; } #shopify-section-{{ section.id }} .smhero__float-icon svg { width: 12px; height: 12px; } #shopify-section-{{ section.id }} .smhero__arrow { display: none; } #shopify-section-{{ section.id }} .smhero__dots { bottom: 14px; } }
  @media (prefers-reduced-motion: reduce) { #shopify-section-{{ section.id }} .smhero__track, #shopify-section-{{ section.id }} .smhero__button, #shopify-section-{{ section.id }} .smhero__arrow, #shopify-section-{{ section.id }} .smhero__image-shell, #shopify-section-{{ section.id }} .smhero__float-card { transition: none; animation: none; } }
{% endstyle %}

<section class="smhero" aria-roledescription="carousel" aria-label="SarvadaMart promotions" data-sm-hero data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.autoplay_speed | times: 1000 }}">
  <div class="smhero__viewport">
    <div class="smhero__track" data-sm-hero-track>
      {% for block in section.blocks %}
        {% liquid
          assign image_loading = 'lazy'
          if forloop.first
            assign image_loading = 'eager'
          endif
        %}
        <article class="smhero__slide{% if forloop.first %} is-active{% endif %}" style="--smh-green: {{ block.settings.primary_green }}; --smh-gold: {{ block.settings.gold }}; --smh-ink: {{ block.settings.heading_color }}; --smh-muted: {{ block.settings.text_color }}; background: {{ block.settings.background }};" data-sm-hero-slide aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ section.blocks.size }}" {{ block.shopify_attributes }}>
          <span class="smhero__shape smhero__shape--one"></span><span class="smhero__shape smhero__shape--two"></span><span class="smhero__pattern"></span>
          <div class="smhero__inner">
            <div class="smhero__content">
              {% if block.settings.badge != blank %}<span class="smhero__badge">{{ block.settings.badge }}</span>{% endif %}
              {% if block.settings.kicker != blank %}<p class="smhero__kicker">{{ block.settings.kicker }}</p>{% endif %}
              {% if block.settings.heading != blank %}<h2 class="smhero__heading">{{ block.settings.heading | newline_to_br }}</h2>{% endif %}
              {% if block.settings.description != blank %}<div class="smhero__description">{{ block.settings.description }}</div>{% endif %}
              {% if section.settings.show_buttons %}{% if block.settings.primary_label != blank or block.settings.secondary_label != blank %}<div class="smhero__buttons">{% if block.settings.primary_label != blank %}<a class="smhero__button smhero__button--primary" href="{{ block.settings.primary_link | default: routes.all_products_collection_url }}">{{ block.settings.primary_label }} <span aria-hidden="true">→</span></a>{% endif %}{% if block.settings.secondary_label != blank %}<a class="smhero__button smhero__button--secondary" href="{{ block.settings.secondary_link | default: routes.all_products_collection_url }}">{{ block.settings.secondary_label }}</a>{% endif %}</div>{% endif %}{% endif %}
              {% if section.settings.show_trust_badges %}<ul class="smhero__trust" aria-label="Shopping benefits"><li class="smhero__trust-item"><span class="smhero__check"><svg viewBox="0 0 16 16"><path d="m3 8 3 3 7-7"/></svg></span>{{ block.settings.trust_badge_1 }}</li><li class="smhero__trust-item"><span class="smhero__check"><svg viewBox="0 0 16 16"><path d="m3 8 3 3 7-7"/></svg></span>{{ block.settings.trust_badge_2 }}</li><li class="smhero__trust-item"><span class="smhero__check"><svg viewBox="0 0 16 16"><path d="m3 8 3 3 7-7"/></svg></span>{{ block.settings.trust_badge_3 }}</li><li class="smhero__trust-item"><span class="smhero__check"><svg viewBox="0 0 16 16"><path d="m3 8 3 3 7-7"/></svg></span>{{ block.settings.trust_badge_4 }}</li></ul>{% endif %}
            </div>
            <div class="smhero__visual">
              <span class="smhero__leaf smhero__leaf--one"></span><span class="smhero__leaf smhero__leaf--two"></span>
              <div class="smhero__image-shell">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1100 | image_tag: class: 'smhero__image', loading: image_loading, widths: '360,480,650,800,1100', sizes: '(min-width: 990px) 42vw, 84vw' }}{% else %}<div class="smhero__image-placeholder" role="img" aria-label="Fresh groceries"></div>{% endif %}</div>
              <div class="smhero__float-card smhero__float-card--top"><span class="smhero__float-icon"><svg viewBox="0 0 24 24"><path d="M3 12h12l-2.5-2.5M15 12l-2.5 2.5M17 7h3l1 4v5h-3M5 17h12"/><circle cx="7" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/></svg></span>{{ block.settings.floating_text_1 }}</div>
              <div class="smhero__float-card smhero__float-card--bottom"><span class="smhero__float-icon"><svg viewBox="0 0 24 24"><path d="M20 7a5 5 0 0 0-8-3 5 5 0 0 0-8 3c0 6 8 12 8 12s8-6 8-12Z"/></svg></span>{{ block.settings.floating_text_2 }}</div>
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
    {% if section.blocks.size > 1 %}<button class="smhero__arrow smhero__arrow--prev" type="button" aria-label="Previous slide" data-sm-hero-prev><svg viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></svg></button><button class="smhero__arrow smhero__arrow--next" type="button" aria-label="Next slide" data-sm-hero-next><svg viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></svg></button><div class="smhero__dots" role="tablist" aria-label="Choose slide">{% for block in section.blocks %}<button class="smhero__dot" type="button" role="tab" aria-label="Go to slide {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-sm-hero-dot="{{ forloop.index0 }}"></button>{% endfor %}</div>{% endif %}
  </div>
</section>

<script>
  (() => { const root = document.querySelector('#shopify-section-{{ section.id }} [data-sm-hero]'); if (!root || root.dataset.ready) return; root.dataset.ready = 'true'; const track = root.querySelector('[data-sm-hero-track]'); const slides = [...root.querySelectorAll('[data-sm-hero-slide]')]; const dots = [...root.querySelectorAll('[data-sm-hero-dot]')]; const previous = root.querySelector('[data-sm-hero-prev]'); const next = root.querySelector('[data-sm-hero-next]'); let index = 0, timer, paused = false; const goTo = value => { index = (value + slides.length) % slides.length; track.style.transform = `translateX(-${index * 100}%)`; slides.forEach((slide, i) => { slide.classList.toggle('is-active', i === index); slide.setAttribute('aria-hidden', i === index ? 'false' : 'true'); }); dots.forEach((dot, i) => dot.setAttribute('aria-current', i === index ? 'true' : 'false')); }; const stop = () => { if (timer) window.clearInterval(timer); }; const start = () => { stop(); if (root.dataset.autoplay === 'true' && slides.length > 1 && !paused && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) timer = window.setInterval(() => goTo(index + 1), Number(root.dataset.speed) || 5000); }; previous?.addEventListener('click', () => { goTo(index - 1); start(); }); next?.addEventListener('click', () => { goTo(index + 1); start(); }); dots.forEach((dot, i) => dot.addEventListener('click', () => { goTo(i); start(); })); root.addEventListener('mouseenter', () => { paused = true; stop(); }); root.addEventListener('mouseleave', () => { paused = false; start(); }); root.addEventListener('focusin', () => { paused = true; stop(); }); root.addEventListener('focusout', () => { paused = false; start(); }); root.addEventListener('keydown', event => { if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(index - 1); start(); } if (event.key === 'ArrowRight') { event.preventDefault(); goTo(index + 1); start(); } }); goTo(0); start(); })();
</script>

{% schema %}
{
  "name": "SM hero banner",
  "tag": "section",
  "class": "section-sm-hero-banner",
  "max_blocks": 3,
  "settings": [
    { "type": "checkbox", "id": "autoplay", "default": true, "label": "Enable autoplay" },
    { "type": "range", "id": "autoplay_speed", "min": 3, "max": 10, "step": 1, "default": 5, "unit": "s", "label": "Autoplay speed" },
    { "type": "checkbox", "id": "show_buttons", "default": true, "label": "Show buttons" },
    { "type": "checkbox", "id": "show_trust_badges", "default": true, "label": "Show trust badges" },
    { "type": "range", "id": "desktop_height", "min": 500, "max": 820, "step": 20, "default": 640, "unit": "px", "label": "Desktop height" },
    { "type": "range", "id": "tablet_height", "min": 480, "max": 760, "step": 20, "default": 560, "unit": "px", "label": "Tablet height" },
    { "type": "range", "id": "mobile_height", "min": 590, "max": 900, "step": 10, "default": 700, "unit": "px", "label": "Mobile height" }
  ],
  "blocks": [
    { "type": "slide", "name": "Hero slide", "settings": [
      { "type": "image_picker", "id": "image", "label": "Grocery hero image" },
      { "type": "text", "id": "badge", "default": "Freshness, delivered", "label": "Offer badge" },
      { "type": "text", "id": "kicker", "default": "Fresh grocery delivered to your door", "label": "Small heading" },
      { "type": "textarea", "id": "heading", "default": "Good food starts with\ngreat ingredients.", "label": "Heading" },
      { "type": "textarea", "id": "description", "default": "From farm-fresh vegetables and fruit to pantry essentials, your everyday shopping is now simpler and more delightful.", "label": "Description" },
      { "type": "text", "id": "primary_label", "default": "Shop now", "label": "Primary button label" },
      { "type": "url", "id": "primary_link", "label": "Primary button link" },
      { "type": "text", "id": "secondary_label", "default": "Explore categories", "label": "Secondary button label" },
      { "type": "url", "id": "secondary_link", "label": "Secondary button link" },
      { "type": "text", "id": "trust_badge_1", "default": "Free Delivery", "label": "Trust badge 1" },
      { "type": "text", "id": "trust_badge_2", "default": "Secure Payment", "label": "Trust badge 2" },
      { "type": "text", "id": "trust_badge_3", "default": "Premium Quality", "label": "Trust badge 3" },
      { "type": "text", "id": "trust_badge_4", "default": "Easy Returns", "label": "Trust badge 4" },
      { "type": "text", "id": "floating_text_1", "default": "Fresh picks daily", "label": "Top floating label" },
      { "type": "text", "id": "floating_text_2", "default": "Packed with care", "label": "Bottom floating label" },
      { "type": "color_background", "id": "background", "default": "linear-gradient(120deg, #EAF8F1 0%, #D9F2E5 100%)", "label": "Background" },
      { "type": "color", "id": "primary_green", "default": "#00845D", "label": "Primary green" },
      { "type": "color", "id": "gold", "default": "#D7A74C", "label": "Gold accent" },
